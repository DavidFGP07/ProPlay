# ---------------------------------------------------------------------------
# Variables de la infraestructura local (docker-compose.yml)
# Copia este archivo a .env: cp .env.example .env
# Cada app tiene además su propio .env (ver apps/api/.env.example y
# apps/web/.env.example).
# ---------------------------------------------------------------------------

# Usuario del contenedor de Postgres
POSTGRES_USER=proplay
# Contraseña del contenedor de Postgres
POSTGRES_PASSWORD=proplay
# Base de datos creada al arrancar el contenedor
POSTGRES_DB=proplay
