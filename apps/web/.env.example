# ---------------------------------------------------------------------------
# apps/web/.env.example  —  copia a apps/web/.env
#
# ATENCIÓN: todo lo que empieza por VITE_ se empaqueta en el bundle y es
# PÚBLICO. Nunca pongas secretos aquí.
# ---------------------------------------------------------------------------

# URL base de la API, incluido el prefijo de versión. Sin barra final.
VITE_API_URL=http://localhost:3000/api/v1

# Puente de datos de demostración: "true" alimenta con la simulación de
# src/mocks/ las vistas cuyo endpoint aún no existe (se marcan con un aviso).
# Con cualquier otro valor, las vistas muestran sólo lo que devuelve la API.
VITE_DEMO_DATA=true
