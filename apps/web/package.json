{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "description": "Cliente web de ProPlay (React + Vite + TailwindCSS), a partir del prototipo de la rama Fronted",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
