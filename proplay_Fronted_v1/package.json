{
  "name": "proplay-prototipo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ProPlay - Prototipo funcional frontend: Plataforma Web para el Scouting de Talento en eSports del Caribe Colombiano",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
